# Versões fixas (nunca "latest"). Conferir no Docker Hub antes de subir.
NGINX_VERSION=1.30.6
CERTBOT_VERSION=v5.8.0

# Portas publicadas no host.
# Testes (antes da virada): 127.0.0.1, 8010 e 8011 — nada de fora alcança.
# Produção (virada): 0.0.0.0, 80 e 443.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443

# Certificado wildcard: <CERT_NAME> + *.<CERT_NAME>
CERT_NAME=example.com
# Recebe os avisos de expiração do Let's Encrypt
LETSENCRYPT_EMAIL=
# Segundos entre as conferências do certificado (o nginx recarrega quando ele muda)
CERT_WATCH_INTERVAL=300
